      "type" : "object"
    },
    "tally" : {
      "properties" : {
        "consulted" : {
          "type" : "integer"
        },
        "credited" : {
          "type" : "integer"
        },
        "lastAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "placed" : {
          "type" : "integer"
        },
        "turns" : {
          "items" : {
            "properties" : {
              "at" : {
                "format" : "date-time",
                "type" : "string"
              },
              "consulted" : {
                "type" : "boolean"
              },
              "credited" : {
                "type" : "boolean"
              },
              "placed" : {
                "type" : "boolean"
              },
              "session" : {
                "type" : "string"
              },
              "turn" : {
                "type" : "string"
              }
            },
            "required" : [
              "session",
              "turn",
              "at"
            ],
            "type" : "object"
          },
          "maxItems" : 8,
          "type" : "array"
        }
      },
      "required" : [
        "placed",
        "consulted",
        "credited",
        "turns"
      ],
      "type" : "object"
    }
  },
  "$id" : "craft-record/1",
  "$ref" : "#/$defs/record",
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "description" : "What Craft learned about a project or was told, with the evidence that would falsify it. Staleness is never stored: an export row carries it as of the export. Spec: Schema/Storage.md.",
  "title" : "Craft record"
}
