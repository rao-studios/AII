{
  "$defs" : {
    "approach" : {
      "properties" : {
        "ask" : {
          "description" : "the person's words",
          "type" : "string"
        },
        "crucial" : {
          "description" : "observed: failures and their fixes, commands that worked",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "phase" : {
          "type" : "string"
        },
        "summary" : {
          "description" : "the model's account of what changed",
          "type" : "string"
        },
        "title" : {
          "description" : "the model's words",
          "type" : "string"
        },
        "verdict" : {
          "properties" : {
            "gap" : {
              "type" : "string"
            },
            "note" : {
              "type" : "string"
            },
            "verdict" : {
              "enum" : [
                "aligned",
                "misaligned",
                "unjudged"
              ],
              "type" : "string"
            }
          },
          "required" : [
            "verdict"
          ],
          "type" : "object"
        },
        "verified" : {
          "description" : "observed: checks that showed the thing working",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        }
      },
      "required" : [
        "ask",
        "title",
        "crucial",
        "verified",
        "phase"
      ],
      "type" : "object"
    },
    "evidence" : {
      "properties" : {
        "basis" : {
          "enum" : [
            "file",
            "body",
            "decl",
            "shape"
          ],
          "type" : "string"
        },
        "check" : {
          "properties" : {
            "command" : {
              "description" : "the command that ran, as the plan wrote it",
              "type" : "string"
            },
            "directory" : {
              "type" : "string"
            },
            "kind" : {
              "type" : "string"
            },
            "label" : {
              "type" : "string"
            },
            "route" : {
              "type" : "string"
            },
            "status" : {
              "type" : "string"
            }
          },
          "required" : [
            "kind",
            "label",
            "status"
          ],
          "type" : "object"
        },
        "from" : {
          "description" : "the superseded record this pointer was inherited from",
          "type" : "string"
        },
        "hash" : {
          "description" : "16 hex: the first eight bytes of SHA-256 of what `basis` names",
          "type" : "string"
        },
        "kind" : {
          "enum" : [
            "file",
            "symbol",
            "check"
          ],
          "type" : "string"
        },
        "observedAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "path" : {
          "description" : "relative to the project root",
          "type" : "string"
        },
        "rev" : {
          "description" : "the file's revision in the project's ledger when observed",
          "type" : "integer"
        },
        "role" : {
          "enum" : [
            "anchor",
            "support",
            "counter",
            "context"
          ],
          "type" : "string"
        },
        "symbol" : {
          "properties" : {
            "id" : {
              "type" : "string"
            },
            "kind" : {
              "type" : "string"
            },
            "qualifiedName" : {
              "type" : "string"
            },
            "selector" : {
              "type" : "string"
            }
          },
          "required" : [
            "id",
            "qualifiedName",
            "kind"
          ],
          "type" : "object"
        },
        "weight" : {
          "maximum" : 12,
          "minimum" : 1,
          "type" : "integer"
        }
      },
      "required" : [
        "kind",
        "role",
        "weight",
        "observedAt"
      ],
      "type" : "object"
    },
    "exportRow" : {
      "properties" : {
        "computedAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "excerpts" : {
          "items" : {
            "properties" : {
              "lines" : {
                "type" : "string"
              },
              "path" : {
                "type" : "string"
              },
              "text" : {
                "type" : "string"
              }
            },
            "required" : [
              "path",
              "lines",
              "text"
            ],
            "type" : "object"
          },
          "type" : "array"
        },
        "recall" : {
          "$ref" : "#/$defs/tally"
        },
        "record" : {
          "$ref" : "#/$defs/record"
        },
        "staleness" : {
          "properties" : {
            "editsSince" : {
              "type" : "integer"
            },
            "grade" : {
              "enum" : [
                "fresh",
                "drifted",
                "contradicted"
              ],
              "type" : "string"
            },
            "notes" : {
              "items" : {
                "type" : "string"
              },
              "type" : "array"
            }
          },
          "required" : [
            "grade",
            "notes"
          ],
          "type" : "object"
        }
      },
      "required" : [
        "record",
        "staleness",
        "computedAt"
      ],
      "type" : "object"
    },
    "instruction" : {
      "properties" : {
        "text" : {
          "description" : "the person's words; empty once they cleared them",
          "type" : "string"
        }
      },
      "required" : [
        "text"
      ],
      "type" : "object"
    },
    "learned" : {
      "properties" : {
        "cause" : {
          "description" : "the workflow agent's own words: the report's cause: line",
          "type" : "string"
        },
        "confirmed" : {
          "description" : "workflows that confirmed with it",
          "type" : "integer"
        },
        "fix" : {
          "description" : "the workflow agent's own words: the report's fix: line",
          "type" : "string"
        },
        "missed" : {
          "description" : "later workflows it was handed to that still failed",
          "type" : "integer"
        },
        "pattern" : {
          "properties" : {
            "code" : {
              "description" : "observed: the toolchain's code for the error",
              "type" : "string"
            },
            "key" : {
              "description" : "the four as one: the pattern's identity",
              "type" : "string"
            },
            "language" : {
              "type" : "string"
            },
            "line" : {
              "description" : "observed: the first error line, paths, numbers and quoted names masked",
              "type" : "string"
            },
            "tool" : {
              "description" : "observed: the program and its subcommand",
              "type" : "string"
            }
          },
          "required" : [
            "tool",
            "line",
            "key"
          ],
          "type" : "object"
        },
        "seenIn" : {
          "description" : "the projects it was confirmed in, by identity",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "workflow" : {
          "description" : "the workflow that first kept it: resolve, workaround",
          "type" : "string"
        }
      },
      "required" : [
        "workflow",
        "pattern",
        "cause",
        "fix",
        "confirmed",
        "missed",
        "seenIn"
      ],
      "type" : "object"
    },
    "ledger" : {
      "properties" : {
        "files" : {
          "additionalProperties" : {
            "properties" : {
              "hash" : {
                "type" : "string"
              },
              "rev" : {
                "type" : "integer"
              }
            },
            "required" : [
              "rev",
              "hash"
            ],
            "type" : "object"
          },
          "type" : "object"
        },
        "format" : {
          "const" : "craft-ledger/1"
        },
        "path" : {
          "type" : "string"
        },
        "project" : {
          "properties" : {
            "id" : {
              "type" : "string"
            },
            "label" : {
              "type" : "string"
            }
          },
          "required" : [
            "id",
            "label"
          ],
          "type" : "object"
        },
        "recall" : {
          "additionalProperties" : {
            "$ref" : "#/$defs/tally"
          },
          "type" : "object"
        },
        "useDays" : {
          "items" : {
            "pattern" : "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type" : "string"
          },
          "type" : "array"
        }
      },
      "required" : [
        "format",
        "project",
        "path",
        "useDays",
        "files",
        "recall"
      ],
      "type" : "object"
    },
    "lesson" : {
      "properties" : {
        "ask" : {
          "description" : "the person's words, for the turn it happened in",
          "type" : "string"
        },
        "doing" : {
          "description" : "observed: the call or command that failed",
          "type" : "string"
        },
        "failed" : {
          "description" : "observed: its first error line",
          "type" : "string"
        },
        "fixedBy" : {
          "description" : "observed: the edit or command that passed after it",
          "type" : "string"
        },
        "kind" : {
          "enum" : [
            "toolFailed",
            "checkFailed",
            "judicatorMiss"
          ],
          "type" : "string"
        },
        "place" : {
          "description" : "the file it failed in, relative to the project",
          "type" : "string"
        },
        "symbol" : {
          "description" : "the scope it failed in, when one was named",
          "type" : "string"
        }
      },
      "required" : [
        "kind",
        "place",
        "doing",
        "failed"
      ],
      "type" : "object"
    },
    "reading" : {
      "properties" : {
        "digest" : {
          "description" : "what was read, digested",
          "type" : "string"
        },
        "format" : {
          "const" : "craft-reading/1"
        },
        "model" : {
          "type" : "string"
        },
        "parts" : {
          "items" : {
            "properties" : {
              "build" : {
                "properties" : {
                  "command" : {
                    "type" : "string"
                  },
                  "from" : {
                    "description" : "the file it was read from, `Makefile:12`",
                    "type" : "string"
                  },
                  "unresolved" : {
                    "description" : "why the harness could not stand behind it",
                    "type" : "string"
                  }
                },
                "required" : [
                  "command"
                ],
                "type" : "object"
              },
              "directory" : {
                "description" : "`.` for the root, else relative to it",
                "type" : "string"
              },
              "note" : {
                "type" : "string"
              },
              "run" : {
                "properties" : {
                  "command" : {
                    "type" : "string"
                  },
                  "from" : {
                    "description" : "the file it was read from, `Makefile:12`",
                    "type" : "string"
                  },
                  "unresolved" : {
                    "description" : "why the harness could not stand behind it",
                    "type" : "string"
                  }
                },
                "required" : [
                  "command"
                ],
                "type" : "object"
              },
              "serve" : {
                "properties" : {
                  "command" : {
                    "type" : "string"
                  },
                  "from" : {
                    "description" : "the file it was read from, `Makefile:12`",
                    "type" : "string"
                  },
                  "unresolved" : {
                    "description" : "why the harness could not stand behind it",
                    "type" : "string"
                  }
                },
                "required" : [
                  "command"
                ],
                "type" : "object"
              },
              "test" : {
                "properties" : {
                  "command" : {
                    "type" : "string"
                  },
                  "from" : {
                    "description" : "the file it was read from, `Makefile:12`",
                    "type" : "string"
                  },
                  "unresolved" : {
                    "description" : "why the harness could not stand behind it",
                    "type" : "string"
                  }
                },
                "required" : [
                  "command"
                ],
                "type" : "object"
              },
              "what" : {
                "type" : "string"
              }
            },
            "required" : [
              "directory",
              "what"
            ],
            "type" : "object"
          },
          "maxItems" : 6,
          "type" : "array"
        },
        "read" : {
          "description" : "the files the model was shown",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "readAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "stack" : {
          "description" : "the languages, tools, frameworks and formats it is made with, by their usual names",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "summary" : {
          "description" : "one line: what the workspace is",
          "type" : "string"
        }
      },
      "required" : [
        "format",
        "summary",
        "stack",
        "parts",
        "read",
        "digest",
        "readAt"
      ],
      "type" : "object"
    },
    "record" : {
      "properties" : {
        "approach" : {
          "$ref" : "#/$defs/approach"
        },
        "claim" : {
          "type" : "string"
        },
        "claimBy" : {
          "enum" : [
            "craft",
            "model",
            "person"
          ],
          "type" : "string"
        },
        "createdAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "evidence" : {
          "items" : {
            "$ref" : "#/$defs/evidence"
          },
          "maxItems" : 16,
          "type" : "array"
        },
        "format" : {
          "const" : "craft-record/1"
        },
        "id" : {
          "pattern" : "^(cv|ap|nt|ls)-[0-9a-f]{16}$",
          "type" : "string"
        },
        "instruction" : {
          "$ref" : "#/$defs/instruction"
        },
        "kind" : {
          "enum" : [
            "approach",
            "note",
            "lesson",
            "instruction",
            "project"
          ],
          "type" : "string"
        },
        "lastValidated" : {
          "description" : "the last time a check found the record holding",
          "format" : "date-time",
          "type" : "string"
        },
        "learned" : {
          "$ref" : "#/$defs/learned"
        },
        "lesson" : {
          "$ref" : "#/$defs/lesson"
        },
        "project" : {
          "properties" : {
            "id" : {
              "type" : "string"
            },
            "label" : {
              "type" : "string"
            }
          },
          "required" : [
            "id",
            "label"
          ],
          "type" : "object"
        },
        "reading" : {
          "$ref" : "#/$defs/reading"
        },
        "revision" : {
          "minimum" : 1,
          "type" : "integer"
        },
        "scope" : {
          "properties" : {
            "language" : {
              "type" : "string"
            },
            "paths" : {
              "items" : {
                "type" : "string"
              },
              "type" : "array"
            },
            "stack" : {
              "description" : "what the work was made with, as the workspace reading named it when the record was kept",
              "items" : {
                "type" : "string"
              },
              "type" : "array"
            }
          },
          "type" : "object"
        },
        "source" : {
          "properties" : {
            "detector" : {
              "type" : "string"
            },
            "kind" : {
              "enum" : [
                "observed",
                "turn",
                "stated",
                "workflow"
              ],
              "type" : "string"
            },
            "model" : {
              "type" : "string"
            },
            "plan" : {
              "type" : "string"
            },
            "rounds" : {
              "type" : "integer"
            },
            "session" : {
              "type" : "string"
            }
          },
          "required" : [
            "kind"
          ],
          "type" : "object"
        },
        "status" : {
          "enum" : [
            "candidate",
            "verified",
            "superseded"
          ],
          "type" : "string"
        },
        "statusChangedAt" : {
          "format" : "date-time",
          "type" : "string"
        },
        "supersededBy" : {
          "type" : "string"
        },
        "supersedes" : {
          "type" : "string"
        }
      },
      "required" : [
        "format",
        "id",
        "kind",
        "revision",
        "project",
        "claim",
        "claimBy",
        "scope",
        "source",
        "status",
        "createdAt",
        "statusChangedAt",
        "lastValidated",
        "evidence"
